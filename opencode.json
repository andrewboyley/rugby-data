{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".venv/**",
      ".opencode/node_modules/**",
      ".codegraph/**",
      ".cocoindex_code/**",
      "data/api_cache.json",
      "web/test-results/**",
      "test-results/**"
    ]
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--executablePath=/usr/bin/chromium"]
    }
  }
}
