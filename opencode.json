{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".venv/**",
      ".opencode/node_modules/**",
      ".codegraph/**",
      ".cocoindex_code/**",
      "data/api_cache.json",
      "web/test-results/**",
      "test-results/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "permission": {
    "bash": {
      "*": "allow",
      "just *": "allow",
      "git *": "allow",
      "cd *web*": "deny",
      "npm run *": "deny",
      "pnpm *": "deny",
      "yarn *": "deny",
      "npm ci*": "ask",
      "npm install*": "ask",
      "npx *": "ask",
      "uv *": "ask"
    }
  },
  "command": {
    "check": {
      "description": "Run all type/lint checks",
      "template": "Run `just check-python` and `just check-web`. Report any failures and propose fixes."
    },
    "lint": {
      "description": "Auto-fix lint issues",
      "template": "Run `just lint-python` and `just lint-web` to apply auto-fixes."
    },
    "build": {
      "description": "Build dataset, graph, and web viewer",
      "template": "Run `just build` (dataset + graph) then `just web`."
    },
    "serve": {
      "description": "Run the viewer preview server",
      "template": "Run `just serve` to build and preview on localhost:8787."
    }
  }
}
